  {
   "name": "VOL_Z2",
   "class": "gain",
   "zone": "ZONES",
   "label": "Volume Z2",
   "script_access": "External",
   "properties": {
    "multi_channel_type": 1,
    "multi_channel_count": 1,
    "max_gain": 0,
    "min_gain": -100
   },
   "values": {
    "gain": -10
   },
   "note": "Panel volume."
  },
  {
   "name": "LIM_Z2",
   "class": "limiter_peak",
   "zone": "ZONES",
   "label": "Limiter Z2",
   "properties": {
    "multi_channel_type": 1,
    "multi_channel_count": 1,
    "b_has_sidechain": false
   },
   "values": {
    "threshold_level": -3
   },
   "note": "-3 dBFS before the amp."
  }
 ],
 "wires": [
  [
   "FLEX_IN.out.${BGM}",
   "BGM_VOL.in.1",
   "Music in"
  ],
  [
   "BGM_VOL.out.1",
   "DUCK.in.1",
   "Music"
  ],
  [
   "BGM_VOL.out.1",
   "DUCK.in.2",
   "Music"
  ],
  [
   "FLEX_IN.out.${PAGE}",
   "PAGE_MIC.in.1",
   "Page mic"
  ],
  [
   "PAGE_MIC.out.1",
   "DUCK.in.Priority",
   "Page"
  ],
  [
   "PAGE_MIC.out.1",
   "PAGE_ROUTE.in.1",
   "Page"
  ],
  [
   "DUCK.out.1",
   "PAGE_ROUTE.in.2",
   "Music z1"
  ],
  [
   "DUCK.out.2",
   "PAGE_ROUTE.in.3",
   "Music z2"
  ],
  [
   "PAGE_ROUTE.out.1",
   "VOL_Z1.in.1",
   "Zone 1"
  ],
  [
   "PAGE_ROUTE.out.2",
   "VOL_Z2.in.1",
   "Zone 2"
  ],
  [
   "VOL_Z1.out.1",
