{
 "description": "Conference room: PC over the Core's USB speakerphone bridge (EC mode), a ceiling microphone over Dante that cancels echo itself (e.g. an array mic with its own AEC), the final speaker feed sent back to the mic as its AEC reference over Dante. Mic mute and meter, a 2 x 3 matrix (PC to the speakers, mic to the PC; mic never to the speakers), volume, EQ, limiter. Needs a Core with Flex channels for the speakers (SPK_L/SPK_R) and Software Dante.",
 "params": {
  "USB_IN": "USB EC Speakerphone 1 In",
  "USB_OUT": "USB EC Speakerphone 1 Out",
  "MIC_RX": "Mic-RX",
  "REF_TX": "Ref-TX",
  "OUTPUTS": "Flex Out",
  "SPK_L": 1,
  "SPK_R": 2
 },
 "param_help": {
  "USB_IN": "Core placeable for audio from the PC",
  "USB_OUT": "Core placeable for audio to the PC",
  "MIC_RX": "Software Dante RX item for the mic",
  "REF_TX": "Software Dante TX item for the AEC reference",
  "OUTPUTS": "Core placeable for the speakers",
  "SPK_L": "output channel, left",
  "SPK_R": "output channel, right"
 },
